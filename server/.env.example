NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=https://your-client-domain.example

# Railway Postgres addon connection string (Settings -> Variables -> DATABASE_URL on the addon)
DATABASE_URL=postgres://user:password@host:5432/railway

# Railway Redis addon connection string (Settings -> Variables -> REDIS_URL on the addon).
# Required for multi-instance deployments; leave unset for a single instance.
REDIS_URL=redis://user:password@host:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me
JWT_EXPIRES_IN=7d

# Set to 1 for human-readable colorized logs in local dev. Deliberately opt-in rather than
# inferred from NODE_ENV - a wrong NODE_ENV value once requested the pino-pretty transport in
# production, where it isn't installed, and crash-looped the service. Unset = plain JSON logs.
# PINO_PRETTY=1

# Defaults to 3 (conservative - sized for local PGlite dev, see PLAN.md deviation #29). Real
# Postgres on Railway can comfortably take the node-postgres default of 10 - raise it here if
# connection throughput ever actually becomes a bottleneck in production.
PG_POOL_MAX=10
